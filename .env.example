# Paths
ENERGYPLUS_HOME=
ECOLOOP_MODEL_PATH=models/base/building.idf
ECOLOOP_WEATHER_PATH=weather/default.epw
ECOLOOP_DATABASE_PATH=runs/ecoloop.db
ECOLOOP_RUNS_DIR=runs
ECOLOOP_SUBMISSION_DIR=submission

# Local Ollama inference
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=30
ECOLOOP_SIMULATION_TIMEOUT_SECONDS=7200
ECOLOOP_MAX_TOOL_ROUNDS=8
ECOLOOP_MAX_CONSECUTIVE_TIMEOUTS=3
ECOLOOP_STATE_TOKEN_BUDGET=1800

# Runtime cadence
ECOLOOP_ZONE_TIMESTEP_MINUTES=15
ECOLOOP_DECISION_INTERVAL_MINUTES=60
ECOLOOP_MAX_ACTION_HOLD_MINUTES=120

# Optional evaluation inputs
ECOLOOP_TARIFF_PER_KWH=0.12
ECOLOOP_CARBON_KG_PER_KWH=0.70
ECOLOOP_DEMAND_THRESHOLD_KW=75
ECOLOOP_DEMO_DISPLAY_DELAY_SECONDS=0
